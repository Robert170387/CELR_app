# Archivos de entorno PHP / Web
.env
.env.local
.env.*.local

# Logs y cachés locales de XAMPP / PHP
/logs/*
!/logs/.gitkeep
/cache/*
!/cache/.gitkeep

# Ignorar el contenido de subidas pero mantener la estructura de directorios
/uploads/avatars/*
/uploads/backups/*
/uploads/logo/*
/uploads/manifests/*
/uploads/proofs/*
/uploads/receipts/*
!/uploads/avatars/.gitkeep
!/uploads/backups/.gitkeep
!/uploads/logo/.gitkeep
!/uploads/manifests/.gitkeep
!/uploads/proofs/.gitkeep
!/uploads/receipts/.gitkeep

